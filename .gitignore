dist/

# Nothing of the sort exists in this project, but the rule belongs here before
# it is ever needed rather than after.
.env
.env.*
*.pem
*.key
.DS_Store
*.log

# Working captures from the headless render loop. Hundreds of iterations of
# "does this actually look right yet" — not source. The curated set for the
# submission lives in screenshots/.
app/shots/

# The local research library: 228 papers and 66 repo READMEs fetched from
# arXiv, OpenAlex and GitHub. Third-party text under a patchwork of licences,
# so it is deliberately NOT redistributed here. BRIEF.md is the synthesis and
# is ours; it cites every source by DOI and local path.
research/
*.tsbuildinfo

# Links the repo to a Vercel account/team. Vercel gitignores this by default.
.vercel

# Playwright browsers, kept out of ~/.cache because that gets swept.
.pw-browsers/
.env.tools
